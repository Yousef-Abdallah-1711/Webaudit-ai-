# ── Datastores ────────────────────────────────────────────────────────────────
# Matches infrastructure/docker-compose.yml. Non-default host ports (5442/6389)
# so this project coexists with others already using 5432/6379.
DATABASE_URL="postgresql://webaudit:webaudit_dev@localhost:5442/webaudit?schema=public"
REDIS_URL="redis://localhost:6389"

# Prisma connection pool, per PROCESS (api and worker each hold their own).
# Prisma's own default is num_cpus * 2 + 1, which on four replicas of an 8-vCPU
# container claims ~68 of PostgreSQL's default max_connections = 100 and then
# fails everything with "too many connections".
#
# The default of 10 is sized for plan.md's MVP scale — 1,000 users, ~60
# concurrent audits — not for a larger number the plan does not claim:
#   ~90 usable connections (100 - 3 superuser - ~7 for migrations/psql/metrics)
#   / 8 processes of headroom (2 api + 2 worker replicas, room to double)
#   = 11, rounded down to 10.
# An audit is a ~5-minute job that touches the database in short bursts, so the
# pool covers concurrent QUERIES, not concurrent audits: 4 x 10 = 40 in-flight
# statements is several times the burst 60 audits produce.
#
# Raise it only alongside the database's real max_connections. Behind PgBouncer
# in transaction mode, set DATABASE_CONNECTION_LIMIT=1. A value already present
# as a query parameter in DATABASE_URL wins over both of these.
DATABASE_CONNECTION_LIMIT="10"
# Seconds a caller waits for a free connection before erroring. Must exceed the
# longest transaction we hold, which is the serializable credit debit.
DATABASE_POOL_TIMEOUT="20"

# ── AI providers ──────────────────────────────────────────────────────────────
# Principle IV: a chain MUST span at least two distinct vendors. The AI executor
# refuses to start otherwise — a startup check, not a runtime surprise.
ANTHROPIC_API_KEY=""
OPENAI_API_KEY=""
GOOGLE_API_KEY=""
AI_PROVIDER_CHAIN="anthropic,openai,google"

# Set to "fixtures" to run without provider spend. Every test suite uses this;
# a suite that requires live spend is a broken suite.
AI_MODE="live"

# ── Secrets ───────────────────────────────────────────────────────────────────
# REQUIRED. The API refuses to start without these — it does not fall back to a
# built-in value when NODE_ENV happens not to be "production". A deploy that
# forgets NODE_ENV would otherwise sign access tokens with a constant committed
# to this repository, letting anyone mint a token carrying isOperator: true.
#
# FR-091: third-party tokens are encrypted at rest. 32 bytes, base64.
#   ENCRYPTION_KEY: openssl rand -base64 32   (must decode to exactly 32 bytes)
#   JWT_*_SECRET:   openssl rand -base64 48   (at least 32 characters)
ENCRYPTION_KEY=""
JWT_ACCESS_SECRET=""
JWT_REFRESH_SECRET=""

# Escape hatch for a local machine ONLY, and it must be the exact string "true".
# It substitutes loudly-labelled placeholder secrets and prints a banner naming
# every variable that fell back. Startup refuses outright if this is set while
# NODE_ENV=production. Never set it on a deployed environment or in CI — CI
# supplies throwaway real values instead, so the fail-closed path stays tested.
ALLOW_INSECURE_DEV_SECRETS=""

# Comma-separated exact origins @webaudit/safe-net permits as an audit target
# regardless of address class — for apps/web/tests/e2e's local fixture server
# only (T109). Refuses to start outright if this is set while
# NODE_ENV=production. Never set it outside that one e2e run.
SAFE_NET_ALLOW_TARGETS=""

# ── OAuth ─────────────────────────────────────────────────────────────────────
GOOGLE_OAUTH_CLIENT_ID=""
GOOGLE_OAUTH_CLIENT_SECRET=""
GITHUB_OAUTH_CLIENT_ID=""
GITHUB_OAUTH_CLIENT_SECRET=""

# ── Object storage (Cloudflare R2) ────────────────────────────────────────────
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET="webaudit-reports"

# ── Email ─────────────────────────────────────────────────────────────────────
RESEND_API_KEY=""
EMAIL_FROM="noreply@webaudit.ai"

# ── Service URLs ──────────────────────────────────────────────────────────────
API_URL="http://localhost:3001"
WEB_URL="http://localhost:3000"
PROBE_POOL_URL="http://localhost:3002"
# R1: sandbox-runner has NO egress and NO database credentials.
SANDBOX_RUNNER_URL="http://localhost:3003"

# ── Worker ───────────────────────────────────────────────────────────────────────
# Directory the worker creates and destroys per-scan workspaces under. Required.
WORKSPACE_BASE_DIR="./.workspaces"

# ── Limits ────────────────────────────────────────────────────────────────────
MAX_ARCHIVE_BYTES="52428800"        # 50 MB (FR-015)
MAX_ARCHIVE_RATIO="100"             # decompression-bomb guard
SCAN_TIMEOUT_MS="900000"            # 15 min (FR-038)
QUESTIONNAIRE_TIMEOUT_MS="600000"   # 10 min (FR-041)
SANDBOX_WALLCLOCK_MS="30000"        # FR-028
SANDBOX_MEMORY_MB="256"             # FR-028

# ─── AI providers (Principle IV: at least two distinct vendors) ───────────────
# The executor refuses to start on fewer than two vendors, and refuses a provider
# with no configured price — FR-081 needs actual cost, and an unpriced provider
# would record every invocation as free.
#
# AI_MODE=fixtures bypasses all of this with a zero-cost two-vendor fixture chain.
# Every test suite runs that way; a suite needing live spend is a broken suite.
AI_MODE=fixtures

# Order is the fallback order. Taken from here, never inferred from which keys exist.
AI_CHAIN=anthropic,openai

# Published rate at the time of writing: $5.00 in / $25.00 out per million tokens.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
ANTHROPIC_INPUT_USD_PER_MTOK=5.00
ANTHROPIC_OUTPUT_USD_PER_MTOK=25.00

# No default model: this repository has no house OpenAI model, and choosing one
# here would bake a cost and capability decision into configuration nobody reviewed.
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_INPUT_USD_PER_MTOK=
OPENAI_OUTPUT_USD_PER_MTOK=

# Optional third vendor. Same reasoning as OpenAI.
GOOGLE_API_KEY=
GOOGLE_MODEL=
GOOGLE_INPUT_USD_PER_MTOK=
GOOGLE_OUTPUT_USD_PER_MTOK=
