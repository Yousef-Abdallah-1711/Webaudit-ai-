# WebAudit AI — production environment for THIS release: AI_MODE=disabled,
# no Paymob. Phase 8 (production-without-Paymob-or-AI master plan).
#
# Consumed by `infrastructure/docker-compose.production.yml` via
# `--env-file`. Copy to `.env.production`, fill in every value, and never
# commit that copy (`.gitignore` already excludes `.env.*` except the
# `.example` files).
#
# What is DELIBERATELY absent from this file, and why:
#   - PAYMOB_API_KEY / PAYMOB_HMAC_SECRET / PAYMOB_INTEGRATION_ID — never set
#     for this release (Phase 5's frozen decision). Leaving them unset is
#     what makes /billing/subscribe, /billing/credits/purchase, and
#     /webhooks/billing fail closed automatically in production — this is
#     already-existing, already-safe application behavior
#     (`makeDevTestOnlyGuard`/`createPaymentProviderFromEnv`), not something
#     this file needs to additionally configure.
#   - ANTHROPIC_API_KEY / OPENAI_API_KEY / GOOGLE_API_KEY — never needed.
#     AI_MODE=disabled means apps/worker never constructs a real provider
#     chain at all (Phase 1) — setting any of these would be inert, and
#     leaving them unset is the correct, intentional state for this release.
#   - AI_MODE=fixtures is never valid here (or anywhere in production) —
#     the executor throws FixtureModeInProductionError if it is ever set
#     this way with NODE_ENV=production. Use AI_MODE=disabled, never
#     "fixtures", for a production deployment with no real AI provider.

# ── Datastores ────────────────────────────────────────────────────────────────
POSTGRES_USER=webaudit
POSTGRES_PASSWORD=
POSTGRES_DB=webaudit
# Composed from the three vars above by docker-compose.production.yml's
# `postgres`/`pgbouncer` services if left as the default host+db name;
# override only if pointing at an external/managed Postgres instead of the
# `postgres` service this compose file also runs.
DATABASE_URL="postgresql://webaudit:CHANGE_ME@postgres:5432/webaudit?schema=public"
# Behind PgBouncer in transaction mode (--profile pooled): set to 1 instead,
# and point DATABASE_URL at pgbouncer:5432 — infrastructure/deploy.md's
# "Connection pooling (PgBouncer)" section explains why.
DATABASE_CONNECTION_LIMIT=10
DATABASE_POOL_TIMEOUT=20

# ── Secrets (REQUIRED — apps/api refuses to boot without these) ───────────────
#   ENCRYPTION_KEY: openssl rand -base64 32   (must decode to exactly 32 bytes)
#   JWT_*_SECRET:   openssl rand -base64 48   (at least 32 characters)
ENCRYPTION_KEY=
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# ── AI (Phase 1 — the load-bearing setting for this whole release) ────────────
# Never "fixtures", never unset, never a real provider chain: apps/worker
# will refuse to boot with anything other than "disabled" unless real AI
# provider keys are also supplied, which this release deliberately does not.
AI_MODE=disabled

# ── Email (Phase 2 — apps/api refuses to boot in production without one of
# these two transports fully configured) ───────────────────────────────────────
# Option A — SMTP (e.g. Hostinger):
EMAIL_TRANSPORT=SMTP
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
# Option B — Resend (leave EMAIL_TRANSPORT unset to select this path):
# RESEND_API_KEY=
EMAIL_FROM=

# ── Service URLs — must match the real public hostnames this deployment
# serves, behind the proxy (P8-T5) ─────────────────────────────────────────────
API_URL="https://api.example.com"
WEB_URL="https://example.com"

# ── Worker (Phase 8) ────────────────────────────────────────────────────────────
WORKER_ID=worker-1
WORKER_HEARTBEAT_INTERVAL_MS=15000
WORKER_HEARTBEAT_TTL_MS=45000

# ── Limits ────────────────────────────────────────────────────────────────────
MAX_ARCHIVE_BYTES=52428800
MAX_ARCHIVE_RATIO=100
SCAN_TIMEOUT_MS=900000
QUESTIONNAIRE_TIMEOUT_MS=600000

# ── Monitoring (optional but recommended before real production traffic) ──────
SENTRY_DSN=
