# Dependencies
node_modules/
.pnpm-store/

# Build output
dist/
build/
out/
.next/
.turbo/
*.tsbuildinfo
# apps/sandbox-runner's own compiled child-harness bundle (host/build-harness.ts) — rebuilt on demand.
.sandbox-build/

# Environment — .env.example IS tracked
.env
.env.*
!.env.example

# Test output
coverage/
test-results/
playwright-report/
blob-report/
.vitest/
# Visual-regression DIFFS are transient; BASELINES under
# design-system/reference-pages/ and tests/visual/__baselines__/ are tracked.
**/__diff_output__/
**/*.actual.png

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# Prisma — generated client only; migrations are tracked
apps/api/prisma/generated/

# Scan workspaces (FR-090: never persisted, never committed)
.workspaces/
tmp/

# Runtime local state — scan workspaces (var/scan-workspaces) and, since T253,
# operator-uploaded capability bundles (var/capabilities-installed, the
# default INSTALLED_CAPABILITIES_ROOT). Local/deploy-time data, never source.
var/

# Tooling scratch
.playwright-mcp/
.worktrees/
.eslintcache
.oxlintcache

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db
*.swp

# Source archive — extracted content lives in design-system/, tracked.
# Keeping the 11MB zip alongside it would duplicate the whole system.
*.zip

# Separate work parked in this worktree — not part of the WebAudit AI product,
# each with its own tooling. Not committed.
/apps/early-access/
/reference-landing/
