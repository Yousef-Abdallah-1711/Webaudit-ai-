# ── Understood by BOTH npm and pnpm — no `npx` warning ────────────────────────
# Exact versions, always. Caret ranges let the toolchain drift between installs,
# which is not acceptable with 92 foundational tasks building on top of it.
save-exact=true

# Refuse to install under a Node or pnpm the project does not declare. This also
# guarantees pnpm >= 9, which is what makes the removals below safe.
engine-strict=true

# ── Removed: pnpm-only keys that only restated pnpm 9 defaults ────────────────
# npm 11 warns "Unknown project config <key>" for every key it does not define,
# on EVERY npm/npx invocation in this repo. Three of the four offenders were
# asserting values pnpm already uses by default, verified against the pinned
# pnpm 9 binary's own defaults:
#
#   strict-peer-dependencies=false   pnpm default: false
#   auto-install-peers=true          pnpm default: true
#   prefer-frozen-lockfile=true      pnpm default: true (and CI passes
#                                    --frozen-lockfile explicitly regardless)
#
# Dropping them changes no pnpm behaviour and removes three warnings per call.
# If pnpm 10+ is ever adopted, re-check those defaults and move the settings to
# `pnpm-workspace.yaml`, which npm never reads — pnpm 9 has no such file support,
# so .npmrc is the only channel available today.

# ── Load-bearing, and unavoidably unknown to npm ──────────────────────────────
# `prisma generate` runs its own `pnpm add @prisma/client` safety net. pnpm
# blocks adds to a workspace root unless -w is passed, which prisma does not do,
# so the generate step fails without this. It has no npm equivalent and cannot
# be hidden from npm: @npmcli/config's checkUnknown() suppresses the warning
# only for keys whose final `:`-delimited segment is a real npm definition, so
# no spelling of this key is both quiet and readable by pnpm. One warning is the
# floor until pnpm 10's pnpm-workspace.yaml settings are available.
ignore-workspace-root-check=true
