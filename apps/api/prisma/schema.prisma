// WebAudit AI — persistence schema
//
// Physical realisation of specs/001-webaudit-mvp-baseline/data-model.md.
// Resolves the constitution's TODO(DATA_MODEL).
//
// Two structural commitments worth stating up front, because they are the
// reason this schema is shaped the way it is:
//
//   1. There is no credit balance column anywhere. A balance is the sum of
//      unexpired lots (Principle VI). Lot accounting is the only way a refund
//      can be correct when plan credits expire and purchased credits do not.
//   2. Issue.state reaches RESOLVED through exactly one inbound edge, and the
//      only trigger is a VerificationAttempt with outcome PASSED (SC-007).
//      No user action writes it.

generator client {
  provider = "prisma-client-js"
  output   = "./generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ──────────────────────────────────────────────────────────── T013 ──

enum ModuleType {
  PERFORMANCE
  SECURITY
  UI
  TESTING
  SEO
}

enum CapabilityLayer {
  CODE
  AI
  BOTH
}

/// Derived from the discovery root, never self-declared by a manifest (R10).
enum TrustLevel {
  VENDORED
  INSTALLED
}

enum InputType {
  URL
  REPOSITORY
  ARCHIVE
}

/// Two escalating levels of established control (FR-017).
enum ControlLevel {
  NONE
  ATTESTED
  VERIFIED
}

enum VerificationMethod {
  FILE
  DNS
}

enum ScanKind {
  INITIAL
  READINESS
}

enum ScanState {
  QUEUED
  RUNNING_PHASE_1 // performance, security, seo
  AWAITING_QUESTIONNAIRE // R4: no worker slot is held here
  RUNNING_PHASE_2 // ui
  RUNNING_PHASE_3 // testing
  RUNNING_MASTER // cross-module synthesis
  RUNNING_DOCS
  COMPLETED
  FAILED
  CANCELLED
  TIMED_OUT
}

enum ModuleState {
  PENDING
  RUNNING
  COMPLETE
  DEGRADED
  FAILED
  NOT_APPLICABLE
}

enum Severity {
  CRITICAL
  HIGH
  MEDIUM
  LOW
  INFO
}

/// Assigned by the module runner from which layer produced the finding.
/// A capability cannot label its own guess as a measurement (FR-032).
enum Attribution {
  MEASURED
  AI_JUDGMENT
}

enum IssueState {
  OPEN
  ASSERTED_FIXED
  RESOLVED
  UNVERIFIABLE
  REOPENED
}

enum VerificationOutcome {
  PASSED
  FAILED
  UNVERIFIABLE
  ERRORED
}

enum CreditKind {
  PLAN
  PURCHASED
}

enum LotSource {
  FREE_GRANT
  PLAN_RENEWAL
  PURCHASE
  REFUND
  PROMOTIONAL
  /// An operator-initiated manual grant or correction (PLAN.md's Finding
  /// HIGH-2 / ADMIN-001). Deliberately distinct from PROMOTIONAL — a
  /// marketing promo redemption and a support-initiated balance correction
  /// are different events for audit purposes, and collapsing them into one
  /// value would make a `CreditTransaction`'s source ambiguous about which
  /// actually happened. `PROMOTIONAL` remains declared-but-unreferenced
  /// (verified: no application code reads or writes it) — not touched by
  /// this addition.
  ADMIN_GRANT
}

enum TxType {
  GRANT
  DEBIT
  REFUND
  EXPIRE
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELLED
  EXPIRED
}

enum AiOutcome {
  SUCCESS
  SCHEMA_INVALID
  RATE_LIMITED
  TIMEOUT
  ERROR
}

enum IntentSource {
  SUPPLIED
  SKIPPED
  DEFAULTED
}

enum PendingPaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  CANCELLED
  EXPIRED
}

// ─── Identity and access ────────────────────────────────────────────── T014 ──

model User {
  id              String    @id @default(cuid())
  email           String    @unique
  name            String?
  passwordHash    String? // null when social-only
  emailVerifiedAt DateTime?
  isOperator      Boolean   @default(false) // FR-008, enforced server-side

  /// FR-091: encrypted at rest. No plaintext column exists for these.
  githubTokenEnc Bytes?
  githubTokenIv  Bytes?
  githubLogin    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  identities    OAuthIdentity[]
  emailTokens   EmailToken[]
  refreshTokens RefreshToken[]
  subscription  Subscription?
  pendingPayments PendingPayment[]
  receipts      Receipt[]
  lots          CreditLot[]
  transactions  CreditTransaction[]
  targets       Target[]
  scans         Scan[]
}

model OAuthIdentity {
  id             String @id @default(cuid())
  userId         String
  provider       String // "google" | "github"
  providerUserId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// FR-004: a matching verified email joins identities, never duplicates.
  @@unique([provider, providerUserId])
  @@index([userId])
}

model EmailToken {
  id        String    @id @default(cuid())
  userId    String
  purpose   String // "verify" | "reset"
  tokenHash String    @unique // the hash, never the token
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
  @@index([expiresAt])
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

// ─── Plans, subscriptions, credits ──────────────────────────────────── T015 ──

model Plan {
  id             String  @id // "free" | "starter" | "pro" | "business"
  name           String
  monthlyCredits Int // 50 / 300 / 1200 / 4000
  creditsRecur   Boolean // false for free — a one-time grant

  allowedInputTypes     InputType[]
  allowLoadGeneration   Boolean
  allowReadinessPass    Boolean
  allowCreditPurchase   Boolean // FR-078: false on free, keeping it an evaluation
  allowCustomCapability Boolean

  concurrentScanLimit Int
  queuePriority       Int // lower value = sooner
  retentionDays       Int // 7 / 30 / 365 / 730

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subscriptions Subscription[]
  capabilities  CapabilityPlan[]
}

model Subscription {
  id     String             @id @default(cuid())
  userId String             @unique
  planId String
  status SubscriptionStatus

  periodStart       DateTime
  periodEnd         DateTime // the renewal boundary that expires PLAN lots
  cancelAtPeriodEnd Boolean  @default(false)

  externalCustomerId     String?
  externalSubscriptionId String?

  /// FR-078: set when the pre-renewal "you are about to lose N plan credits"
  /// warning has been sent for the current period, so the sweep does not
  /// re-send it. Cleared on renewal.
  renewalWarningSentAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan Plan @relation(fields: [planId], references: [id])

  @@index([status, periodEnd]) // renewal + expiry sweep
  @@index([planId])
}

model PendingPayment {
  id                String   @id @default(cuid())
  userId            String
  kind              String
  providerReference String   @unique
  amountMicros      Int
  status            PendingPaymentStatus @default(PENDING)
  metadata          Json
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@index([userId, status])
    @@index([status, createdAt])
  }

model Receipt {
  id                String   @id @default(cuid())
  userId            String
  billingEventId    String   @unique
  providerReference String
  kind              String
  amountMicros      Int
  html              String
  createdAt         DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

/// One row per grant. `amountRemaining` is the only mutable field, and it moves
/// only inside the debit/refund transaction.
model CreditLot {
  id     String     @id @default(cuid())
  userId String
  kind   CreditKind
  source LotSource

  amountGranted   Int
  amountRemaining Int

  /// Null means never expires — every PURCHASED lot. This single nullable column
  /// is what makes SC-022's first half true by construction: the expiry sweep
  /// cannot select a row it can never match.
  expiresAt DateTime?

  createdAt DateTime @default(now())

  user        User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  allocations CreditAllocation[]

  /// Consumption order (FR-078): expiring first, nulls last.
  @@index([userId, expiresAt, createdAt])
  @@index([userId, kind])
}

model CreditTransaction {
  id     String @id @default(cuid())
  userId String
  type   TxType
  amount Int // always positive; `type` carries the direction
  reason String // "scan:full_audit", "reverify:issue", ...

  scanId  String?
  issueId String?

  /// A REFUND points at the DEBIT it reverses, so a debit can be reversed once.
  reversesId String? @unique

  /// The BillingEvent whose effect produced this GRANT, so a provider retry
  /// of the same event can never grant credits twice (grantLot's own
  /// idempotency key). Null for every non-webhook grant (registration's free
  /// allocation, the direct dev/test billing routes) -- Postgres treats
  /// multiple nulls as distinct, so those never collide with each other.
  billingEventId String? @unique

  createdAt DateTime @default(now())

  user        User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  allocations CreditAllocation[]
  reverses    CreditTransaction? @relation("TxReversal", fields: [reversesId], references: [id], onDelete: SetNull)
  reversedBy  CreditTransaction? @relation("TxReversal")

  @@index([userId, createdAt]) // FR-076: user-visible movement history
  @@index([scanId])
  @@index([issueId])
}

/// The join that makes refunds correct: which lots a debit drew from, and how
/// much from each. Without it, a refund cannot know which lifetime to return to.
model CreditAllocation {
  id            String @id @default(cuid())
  transactionId String
  lotId         String
  amount        Int

  transaction CreditTransaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  lot         CreditLot         @relation(fields: [lotId], references: [id])

  @@unique([transactionId, lotId])
  @@index([lotId])
}

// ─── Targets and scans ──────────────────────────────────────────────── T016 ──

model Target {
  id             String    @id @default(cuid())
  userId         String
  inputType      InputType
  canonicalValue String // normalized URL origin, repo full name, or archive key
  displayName    String

  controlLevel ControlLevel @default(NONE)
  attestedAt   DateTime?
  attestedBy   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user          User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  verifications TargetVerification[]
  scans         Scan[]

  /// FR-018: one target row per user per thing.
  @@unique([userId, inputType, canonicalValue])
  @@index([userId])
}

/// A history, not a flag. A token can be issued, confirmed, then removed — and
/// re-confirming immediately before each Level 2 check is what defeats SC-021's
/// third case (a target verified once and since changed hands).
model TargetVerification {
  id       String             @id @default(cuid())
  targetId String
  method   VerificationMethod
  token    String // system-issued

  issuedAt      DateTime  @default(now())
  confirmedAt   DateTime?
  lastCheckedAt DateTime?
  revokedAt     DateTime?

  target Target @relation(fields: [targetId], references: [id], onDelete: Cascade)

  @@index([targetId, confirmedAt])
}

model Scan {
  id       String    @id @default(cuid())
  userId   String
  targetId String
  kind     ScanKind  @default(INITIAL)
  state    ScanState @default(QUEUED)

  requestedModules ModuleType[]

  /// Resolved once at scan start and held for the scan's duration (R10). An
  /// operator toggling a capability mid-scan must not produce a half-configured
  /// audit, and the scan must record what actually ran.
  capabilitySnapshot Json

  quotedCredits  Int
  chargedCredits Int @default(0)

  overallScore Int?
  summary      String?

  /// A READINESS scan points at the INITIAL scan it is compared against.
  baselineScanId String?

  questionnaireDeadline DateTime? // R4

  startedAt     DateTime?
  completedAt   DateTime?
  failureReason String?

  /// FR-092: set when the "this report is approaching removal" warning has been
  /// sent, so the retention sweep does not re-send it.
  retentionWarningSentAt DateTime?
  /// FR-092: set when the retention sweep has removed the report's findings and
  /// artifacts. The report route then returns a "removed" response rather than a
  /// synthesized one; the row itself survives so the movement history still
  /// references it.
  reportRemovedAt DateTime?

  /// FR-090: the cleanup owner reads this and destroys it on every exit path.
  workspacePath String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user          User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  target        Target            @relation(fields: [targetId], references: [id], onDelete: Cascade)
  baseline      Scan?             @relation("ScanBaseline", fields: [baselineScanId], references: [id], onDelete: SetNull)
  derivedScans  Scan[]            @relation("ScanBaseline")
  moduleResults ModuleResult[]
  issues        Issue[]
  executions    CapabilityExecution[]
  invocations   AiInvocation[]
  designIntent  DesignIntent?
  verdict       ReadinessVerdict?

  @@index([userId, createdAt])
  @@index([state]) // queue pickup + timeout sweep
  @@index([targetId, kind, completedAt]) // regression comparison
  @@index([baselineScanId])
  // FR-018 (review finding H4): a PARTIAL unique index on (userId, targetId)
  // WHERE state NOT IN (terminal) enforces one-active-scan-per-target as a
  // database invariant, not just a create-scan.ts read-then-write check.
  // Prisma's schema DSL has no partial-index syntax, so it lives in the raw
  // migration 20260830090000_scan_one_active_per_target and `prisma migrate
  // dev` will report it as drift — do not "fix" that by dropping it.
}

model ModuleResult {
  id     String      @id @default(cuid())
  scanId String
  module ModuleType
  state  ModuleState @default(PENDING)

  /// Null unless the area completed. FR-053 is enforced at read time: the
  /// overall score averages only non-null scores, so an incomplete area can
  /// neither inflate nor deflate the total.
  score Int?

  summary        String?
  skippedReason  String? // FR-021: why NOT_APPLICABLE
  degradedReason String? // FR-035: e.g. provider chain exhausted

  startedAt   DateTime?
  completedAt DateTime?

  scan   Scan    @relation(fields: [scanId], references: [id], onDelete: Cascade)
  issues Issue[]

  @@unique([scanId, module])
}

model Issue {
  id             String @id @default(cuid())
  scanId         String
  moduleResultId String

  /// R3: deterministic identity, computed by the capability from its own
  /// fingerprintParts. Survives re-auditing, which is what makes targeted
  /// re-verification, recurrence detection, and regression diffing possible.
  fingerprint String

  /// Routes re-verification back to the check that owns this finding (FR-059).
  checkId String

  severity    Severity
  title       String
  explanation String
  consequence String
  location    String?
  evidence    Json?

  /// FR-032 / SC-006. Set by the runner, not by the capability.
  attribution Attribution

  fixPrompt String

  state                IssueState   @default(OPEN)
  requiredControlLevel ControlLevel @default(NONE)

  assertedFixedAt DateTime?
  resolvedAt      DateTime?
  reopenedAt      DateTime? // FR-064 keeps the history

  /// Retained across a reopen so "this was verified before" is never lost.
  previouslyResolved Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  scan         Scan                  @relation(fields: [scanId], references: [id], onDelete: Cascade)
  moduleResult ModuleResult          @relation(fields: [moduleResultId], references: [id], onDelete: Cascade)
  attempts     VerificationAttempt[]

  @@unique([scanId, fingerprint]) // one row per problem per scan
  @@index([scanId, severity, state]) // the fixes board query
  @@index([fingerprint]) // cross-scan recurrence + regression
  @@index([moduleResultId])
}

model VerificationAttempt {
  id      String              @id @default(cuid())
  issueId String
  outcome VerificationOutcome

  /// FR-061: mandatory on FAILED. A negative verdict without evidence is a
  /// requirement violation, not a terse response.
  evidence Json?

  creditsCharged Int
  durationMs     Int
  createdAt      DateTime @default(now())

  issue Issue @relation(fields: [issueId], references: [id], onDelete: Cascade)

  @@index([issueId, createdAt])
}

// ─── Capabilities and cost ──────────────────────────────────────────── T017 ──

model Capability {
  id      String          @id // manifest id, e.g. "headers-checker"
  name    String
  version String
  module  ModuleType
  layer   CapabilityLayer

  /// From the discovery root (R10). A manifest cannot declare itself trusted.
  trust TrustLevel

  originalSource String?
  license        String?

  requiresCode         Boolean      @default(false)
  requiresScreenshot   Boolean      @default(false)
  requiredControlLevel ControlLevel @default(NONE) // gates load generation

  estimatedTokens Int @default(0) // FR-082

  isEnabled Boolean @default(true)

  vendoredAt  DateTime?
  installedAt DateTime?
  updatedAt   DateTime  @updatedAt

  plans      CapabilityPlan[]
  executions CapabilityExecution[]

  @@index([module, layer, isEnabled])
  @@index([trust])
}

/// FR-026: restrict a capability to specific tiers.
model CapabilityPlan {
  capabilityId String
  planId       String

  capability Capability @relation(fields: [capabilityId], references: [id], onDelete: Cascade)
  plan       Plan       @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@id([capabilityId, planId])
  @@index([planId])
}

/// The unit that makes cost attributable (Principle VI). Margin per capability
/// is an aggregation over this table, not an estimate.
model CapabilityExecution {
  id           String     @id @default(cuid())
  scanId       String
  capabilityId String
  module       ModuleType

  succeeded     Boolean
  skippedReason String?
  findingCount  Int      @default(0)
  durationMs    Int

  /// Integer micros. Money and floats do not mix, and FR-081's reconciliation
  /// requires exactness. A CODE-layer execution must record 0 (Principle III).
  costMicros Int @default(0)

  errorMessage String?
  createdAt    DateTime @default(now())

  scan        Scan           @relation(fields: [scanId], references: [id], onDelete: Cascade)
  capability  Capability     @relation(fields: [capabilityId], references: [id])
  invocations AiInvocation[]

  @@index([scanId])
  @@index([capabilityId, createdAt]) // FR-082: estimate vs actual drift
}

model AiInvocation {
  id          String  @id @default(cuid())
  executionId String?
  scanId      String?

  provider String
  model    String

  /// 0 = primary. Any value above 0 means a fallback carried the request,
  /// which is the signal Principle IV exists to make visible.
  chainPosition Int

  promptTokens Int
  outputTokens Int
  latencyMs    Int
  costMicros   Int
  outcome      AiOutcome

  /// T307 — a short hash of the static prompt `instructions` text that produced
  /// this invocation (a module prompt or master-report), so historical rows can
  /// be grouped by prompt wording without a full versioned prompt registry.
  /// Null for invocations recorded before this column existed. Never derived
  /// from scan-specific content (measured findings, capability notes).
  promptVersion String?

  createdAt DateTime @default(now())

  execution CapabilityExecution? @relation(fields: [executionId], references: [id], onDelete: Cascade)
  scan      Scan?                @relation(fields: [scanId], references: [id], onDelete: Cascade)

  @@index([scanId])
  @@index([executionId])
  @@index([provider, createdAt]) // provider health + spend
}

// ─── AI provider chain administration ────────────────────────────────── T208 ──

/// T208 — the operator's declared AI provider chain (FR-087). Read
/// providers.service.ts's module note before touching this: this table
/// records what an operator has *chosen* and validates it with the real
/// `buildChain` guard (packages/ai-executor/src/chain.ts) at write time. It
/// is NOT read by any running process today — `apps/worker/src/index.ts`
/// still boots its executor once, from `AI_CHAIN` / per-vendor env vars, via
/// `createExecutorFromEnv` (packages/ai-executor/src/from-env.ts). Wiring a
/// live process to re-read this table on a schedule or on demand is a real,
/// separate, larger change that is out of scope here.
model ProviderChainEntry {
  id     String @id @default(cuid())
  vendor String
  model  String

  /// The fallback order — position 0 is primary. Unique so "the chain" has
  /// exactly one order, never a tie a reader has to break.
  position Int @unique

  /// Lets an operator pull a vendor from the (eventual) live chain without
  /// losing its configuration. See providers.service.ts's module note for
  /// what this flag does and does not gate today.
  isEnabled Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([vendor])
}

// ─── Design intent, verdicts, audit log ─────────────────────────────── T018 ──

model DesignIntent {
  id     String @id @default(cuid())
  scanId String @unique

  /// FR-041 records DEFAULTED explicitly, so a report can say intent was never
  /// supplied rather than implying the defaults were chosen.
  source IntentSource

  audience          String?
  stylePreference   String?
  admiredReferences String[]
  brandColors       String[]
  answeredAt        DateTime?

  scan Scan @relation(fields: [scanId], references: [id], onDelete: Cascade)
}

model ReadinessVerdict {
  id             String @id @default(cuid())
  scanId         String @unique
  baselineScanId String

  isReady      Boolean
  overallScore Int
  baselineScore Int

  moduleOutcomes Json // per-area score, threshold, pass/fail
  regressions    Json // FR-069: named, not merely counted
  improvements   Json

  blockers       String[] // FR-070
  certificateKey String? // FR-072
  // Independent of certificateKey: a mailer failure must retry without
  // re-generating the certificate, and a certificate-generation failure must
  // not be blocked on the email ever sending. See T166/T167's guard note.
  certificateEmailSentAt DateTime?

  createdAt DateTime @default(now())

  scan Scan @relation(fields: [scanId], references: [id], onDelete: Cascade)

  @@index([baselineScanId])
}

/// FR-089: every operator action, attributable, append-only.
///
/// `actorId` deliberately carries NO foreign key to `User`. This is a decision,
/// not an omission — every other actor reference in this schema is a real
/// relation, so a reviewer is right to stop here and ask why this one is not.
///
/// An append-only audit log has to outlive the actor it describes. With a
/// relation, only three behaviours are available and each destroys the record:
///
///   - `onDelete: Cascade` deletes the log rows when the operator is deleted —
///     the operator who did the most damage is the one whose trail vanishes,
///     and deleting your own account becomes a way to erase your own history.
///   - `onDelete: SetNull` keeps the row but forgets who acted, which breaks
///     the "attributable" half of FR-089 for exactly the entries most likely to
///     matter in an investigation.
///   - `onDelete: Restrict` keeps both, but makes an audit entry a permanent
///     block on account deletion. FR-009 requires that a user be able to delete
///     their account; a row that can never be deleted contradicts it.
///
/// So the column stores the actor's id as an immutable fact about what happened,
/// not as a live pointer to a row that still exists. A dangling `actorId` after
/// an account deletion is the intended state: the event is still attributed even
/// though the account is gone. Readers must therefore treat resolution as
/// optional — join to `User` with a left join and render "deleted user <id>" on
/// a miss. Never an inner join: that silently hides deleted actors' entries and
/// reintroduces the erasure the missing FK exists to prevent.
///
/// The `@@index([actorId, createdAt])` below is what makes "everything this
/// actor did" fast without a relation. Nothing writes an update or a delete to
/// this table; append-only is enforced in the service layer, not by a constraint
/// (PostgreSQL has no append-only table), and that is a separate matter from the
/// missing FK.
model AuditLogEntry {
  id          String  @id @default(cuid())
  /// Intentionally unconstrained — see the note above. Not a relation field.
  actorId     String
  action      String
  subjectType String
  subjectId   String?
  before      Json?
  after       Json?

  createdAt DateTime @default(now())

  @@index([actorId, createdAt])
  @@index([subjectType, subjectId])
}

/// T187 — the billing webhook's idempotency ledger.
///
/// The `id` is the *external* event id from the payment provider. A second
/// delivery of the same event (providers retry aggressively) finds the row
/// already here — but "the row exists" is not by itself "handled": see
/// `appliedAt` below. Only a delivery whose row is already *applied* is
/// acknowledged without re-running its effect; a received-but-not-applied
/// row is retried. Getting this distinction right is what keeps a renewal
/// granted twice, or a purchase credited twice, from being possible — exactly
/// the class of bug FR-078/SC-022 forbid — while still letting a genuinely
/// failed attempt recover instead of silently vanishing.
model BillingEvent {
  /// The provider's event id, verbatim. Not a cuid.
  id         String   @id
  type       String
  receivedAt DateTime @default(now())
  /// Set only once the event's effect (subscribe/renew/purchase/...) has
  /// actually applied. Null means "received but not yet applied" — a retry
  /// of such an event re-attempts the effect rather than treating the row's
  /// mere existence as "handled" (2026-09-02 review, Finding 6).
  appliedAt  DateTime?
  /// The verified payload, for an operator reconciling a disputed charge.
  payload    Json?

  @@index([type, receivedAt])
}
