{
  "name": "@webaudit/sandbox-runner",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "R1: untrusted capability isolation. NO network egress, NO database credentials.",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./conformance": "./src/host/conformance.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "dev": "node --env-file-if-exists=../../.env --import tsx --watch src/serve.ts",
    "start": "node --env-file-if-exists=../../.env --import tsx src/serve.ts"
  },
  "dependencies": {
    "@webaudit/types": "workspace:*",
    "@webaudit/config": "workspace:*",
    "@webaudit/capability-sdk": "workspace:*",
    "esbuild": "0.28.2",
    "undici": "7.29.0"
  }
}
